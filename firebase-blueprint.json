{
  "entities": {
    "FranchiseApplication": {
      "title": "FranchiseApplication",
      "description": "Franchise partner application submission with applicant details, plan, financials, documents and status.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "planId": { "type": "string" },
        "currency": { "type": "string", "enum": ["INR", "USD"] },
        "status": {
          "type": "string",
          "enum": ["draft", "submitted", "under_review", "compliance_pending", "approved", "rejected", "agreement_issued", "activated"]
        },
        "applicant": {
          "type": "object",
          "properties": {
            "fullName": { "type": "string" },
            "email": { "type": "string" },
            "phone": { "type": "string" },
            "companyName": { "type": "string" },
            "country": { "type": "string" },
            "stateProvince": { "type": "string" },
            "city": { "type": "string" },
            "postalCode": { "type": "string" },
            "entityType": { "type": "string" }
          },
          "required": ["fullName", "email", "phone", "country", "city"]
        },
        "financials": {
          "type": "object",
          "properties": {
            "liquidCapital": { "type": "number" },
            "netWorth": { "type": "number" },
            "creditScoreTier": { "type": "string" },
            "fundingSource": { "type": "string" }
          }
        }
      },
      "required": ["id", "createdAt", "planId", "status", "applicant"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable security and audit trail log entry for franchise actions.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "action": { "type": "string" },
        "targetId": { "type": "string" },
        "details": { "type": "string" },
        "actorRole": { "type": "string" }
      },
      "required": ["id", "timestamp", "action", "details"]
    }
  },
  "firestore": {
    "/applications/{applicationId}": {
      "schema": "FranchiseApplication",
      "description": "Collection of all submitted franchise applications"
    },
    "/audit_logs/{auditId}": {
      "schema": "AuditLog",
      "description": "System audit and security event trail"
    }
  }
}
