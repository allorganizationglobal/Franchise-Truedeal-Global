rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to validate alphanumeric IDs
    function isValidId(docId) {
      return docId is string && docId.size() > 0 && docId.size() <= 128;
    }

    // Franchise Applications
    match /applications/{applicationId} {
      allow read: if true;
      allow create: if isValidId(applicationId);
      allow update: if isValidId(applicationId);
      allow delete: if false;
    }

    // Audit logs collection - append only
    match /audit_logs/{auditId} {
      allow read: if true;
      allow create: if isValidId(auditId);
      allow update, delete: if false;
    }

    // Connection testing
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
