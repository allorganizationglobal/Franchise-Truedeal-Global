# Server-side Environment Variables (Names Only — NEVER commit real secrets or expose via VITE_)

# PayU India Classic Hosted Checkout (Server-side ONLY)
# Use PAYU_ENV="test" for https://test.payu.in/_payment and PAYU_ENV="production" for https://secure.payu.in/_payment
PAYU_ENV="test"
PAYU_MERCHANT_KEY=""
PAYU_MERCHANT_SALT=""
PAYU_WEBHOOK_SECRET=""

# Canonical Portal Base URL (used for PayU surl/furl callback & webhook URLs)
APP_BASE_URL="https://businessfranchise.truedealglobal.com"

# Firebase Project ID (for IAM-free server-side Firebase ID token verification)
FIREBASE_PROJECT_ID="rational-medium-x5wls"

# TRUEDEAL GLOBAL CRM Integration (Server-side only)
TRUEDEAL_LEAD_API_KEY=""

# SendGrid Transactional Email (Server-side only)
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="info@truedealglobal.com"
SENDGRID_TO_EMAIL="info@truedealglobal.com"

# Session Security (Server-side only — generate 32+ random bytes in production)
SESSION_SECRET=""
