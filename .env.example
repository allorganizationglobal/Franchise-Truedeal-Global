# Server-side Environment Variables (Names Only — NEVER commit real secrets or expose via VITE_)

# Razorpay Standard Web Checkout (Server-side ONLY — NEVER expose SECRET in browser)
# Enter your replacement RAZORPAY_KEY_SECRET and RAZORPAY_WEBHOOK_SECRET directly in Vercel Project Settings
RAZORPAY_MODE="test"
RAZORPAY_KEY_ID="rzp_test_U3VIznAN282H0E"
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Public Razorpay Key ID for Vite client (KEY_ID ONLY — NEVER expose SECRET in VITE_*)
VITE_RAZORPAY_KEY_ID="rzp_test_U3VIznAN282H0E"

# Optional Server-Controlled GST Policy ("not_applicable" | "excluded" | "included")
RAZORPAY_GST_MODE="not_applicable"
RAZORPAY_GST_RATE_PERCENT="18"

# PayU India Classic Hosted Checkout (Server-side ONLY — Preserved)
# Use PAYU_ENV="test" for https://test.payu.in/_payment and PAYU_ENV="production" for https://secure.payu.in/_payment
PAYU_ENV="test"
PAYU_MERCHANT_KEY=""
PAYU_MERCHANT_SALT=""
PAYU_WEBHOOK_SECRET=""

# Canonical Portal Base URL (used for payment callback & webhook URLs)
APP_BASE_URL="https://businessfranchise.truedealglobal.com"

# Firebase Project ID (for IAM-free server-side Firebase ID token verification)
FIREBASE_PROJECT_ID="rational-medium-x5wls"

# TRUEDEAL GLOBAL CRM Integration (Server-side only)
TRUEDEAL_LEAD_API_KEY=""

# SendGrid Transactional Email (Server-side only)
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="info@truedealglobal.com"
SENDGRID_TO_EMAIL="info@truedealglobal.com"

# Session Security (Server-side only — generate 32+ random bytes in production)
SESSION_SECRET=""
