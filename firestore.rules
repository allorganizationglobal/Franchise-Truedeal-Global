rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Check if user is authenticated with Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if user is an authorized TrueDeal Global administrator
    function isAuthorizedAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == 'allorganizationglobal@gmail.com' ||
         request.auth.token.email == 'director@truedealglobal.com' ||
         request.auth.token.email.matches('.*@truedealglobal[.]com'));
    }

    // Helper: Check if authenticated user is the legitimate applicant owner of the record
    function isApplicationOwner(applicantEmail) {
      return isAuthenticated() && request.auth.token.email != null &&
        request.auth.token.email.lower() == applicantEmail.lower();
    }

    // Helper: Validate application document structure on creation by public visitors
    function isValidApplicationSubmission() {
      let data = request.resource.data;
      return data.id is string && data.id.size() > 0 && data.id.size() <= 64 &&
             data.applicant is map &&
             data.applicant.fullName is string && data.applicant.fullName.size() >= 2 &&
             data.applicant.email is string && data.applicant.email.size() >= 5 &&
             data.applicant.phone is string && data.applicant.phone.size() >= 8 &&
             data.planId is string &&
             data.status in ['submitted', 'under_review', 'automated_verified', 'draft'] &&
             data.createdAt is string;
    }

    // 1. Franchise Applications Collection
    match /applications/{applicationId} {
      // Authorized administrators can read all applications;
      // Authenticated applicants can read ONLY their own application matching their verified email
      allow read: if isAuthorizedAdmin() || 
                     (resource != null && isApplicationOwner(resource.data.applicant.email));
      
      // Public visitors can submit a valid, well-formed new application
      allow create: if isValidApplicationSubmission();
      
      // Only authorized administrators can update status, add review notes, or approve
      allow update: if isAuthorizedAdmin();
      
      // Applications cannot be deleted
      allow delete: if false;
    }

    // 2. Audit Trail Logs - Immutable & restricted to administrators
    match /audit_logs/{auditId} {
      allow read: if isAuthorizedAdmin();
      allow create: if isAuthorizedAdmin() || isAuthenticated();
      allow update, delete: if false;
    }

    // 3. User Profiles - Isolated to profile owner or administrator
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAuthorizedAdmin());
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAuthorizedAdmin());
    }

    // 4. Connection Probe Doc
    match /test/{docId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }
  }
}
